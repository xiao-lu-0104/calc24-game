{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "运行游戏",
      "type": "process",
      "command": "${workspaceFolder}\\计算24点游戏.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "构建",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "运行自检",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command",
        "Start-Process -FilePath '.\\计算24点游戏.exe' -ArgumentList '--selftest','--log' -Wait; Get-Content .\\selftest.log -Encoding Default"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
