/*==========================================================================
 *  计算二十四点  ——  声音与背景图资源脚本
 *
 *  把 音频\ 目录里的 mp3 打包进 exe，这样单独发送一个 exe 也能听到声音。
 *  程序运行时优先使用外置的 音频\ 目录（方便替换素材），
 *  找不到才解压内嵌副本到临时目录播放。
 *
 *  编译： windres 计算24点游戏.rc -O coff -o 资源.o --codepage=936
 *         g++ ... 资源.o -lgdi32 -lwinmm -lmsimg32
 *========================================================================*/

#include <windows.h>

101 RCDATA "音频\\背景音乐.mp3"
102 RCDATA "音频\\阿姨你快一点啦阿姨.mp3"
103 RCDATA "音频\\嘿嘿.mp3"
104 RCDATA "音频\\你干嘛哎哟.mp3"
105 RCDATA "音频\\牛逼啊这个人 有操作的呀.mp3"
106 RCDATA "音频\\哎呀.mp3"
107 RCDATA "音频\\叮叮叮.mp3"

/* 界面背景图：写意山水（原图底部的水印已裁掉），随 exe 一起分发 */
201 BITMAP "图片\\背景.bmp"
